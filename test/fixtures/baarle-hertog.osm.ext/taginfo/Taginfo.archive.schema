namespace osm_ext {
struct KeyEntry
{
    key_idx : u64 : 40;
    count_nodes : u64 : 40;
    count_ways : u64 : 40;
    count_relations : u64 : 40;
    @range( values )
    value_first_idx : u64 : 40;
    @range( combos )
    combo_first_idx : u64 : 40;
}
}

namespace osm_ext {
struct ValueEntry
{
    value_idx : u64 : 40;
    @range( node_post )
    node_first_idx : u64 : 40;
    @range( way_post )
    way_first_idx : u64 : 40;
    @range( rel_post )
    rel_first_idx : u64 : 40;
    @range( tag_combos )
    tag_combo_first_idx : u64 : 40;
}
}

namespace osm_ext {
struct Ref
{
    value : u64 : 40;
}
}

namespace osm_ext {
struct ComboEntry
{
    other_key_idx : u64 : 40;
    together_count : u64 : 40;
}
}

namespace osm_ext {
struct TagComboEntry
{
    other_key_idx : u64 : 40;
    other_value_idx : u64 : 40;
    together_count : u64 : 40;
}
}

namespace osm_ext {
const u64 INVALID_IDX = 1099511627775;
}

namespace osm_ext {
archive Taginfo
{
    keys : vector< .osm_ext.KeyEntry >;
    values : vector< .osm_ext.ValueEntry >;
    node_post : vector< .osm_ext.Ref >;
    way_post : vector< .osm_ext.Ref >;
    rel_post : vector< .osm_ext.Ref >;
    combos : vector< .osm_ext.ComboEntry >;
    tag_combos : vector< .osm_ext.TagComboEntry >;
}
}

