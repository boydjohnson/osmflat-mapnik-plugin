<?xml version="1.0" encoding="utf-8"?>
<Map background-color="white" srs="+proj=longlat +datum=WGS84 +no_defs">

  <Style name="ways">
    <!-- Base: every way thin gray. -->
    <Rule>
      <LineSymbolizer stroke="#cccccc" stroke-width="0.4"/>
    </Rule>
    <!-- Primary highways red + thick. The [highway] reference forces "highway"
         into query::property_names(), exercising the query-driven attributes. -->
    <Rule>
      <Filter>[highway] = 'primary'</Filter>
      <LineSymbolizer stroke="#e01020" stroke-width="2.0"/>
    </Rule>
  </Style>

  <Layer name="osmflat" srs="+proj=longlat +datum=WGS84 +no_defs">
    <StyleName>ways</StyleName>
    <Datasource>
      <Parameter name="type">osmflat</Parameter>
      <Parameter name="file">@ARCHIVE@</Parameter>
      <Parameter name="osm_type">way</Parameter>
    </Datasource>
  </Layer>

</Map>
