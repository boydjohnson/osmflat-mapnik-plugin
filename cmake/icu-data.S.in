/* Generated by cmake/StaticRender.cmake from cmake/icu-data.S.in.
 *
 * Embeds ICU's common data file into `render` as the symbol osmflat_icudt,
 * which render.cpp hands to udata_setCommonData() before anything touches ICU.
 * Needed where libicudata.a is a stub and the real data ships as a separate
 * .dat file (Alpine: icu-data-full), which a relocated binary can't find. ICU
 * requires the blob to be 16-byte aligned. ELF only: macOS links Homebrew's
 * libicudata.a, which already carries the data. */
    .section .rodata.osmflat_icudt,"a"
    .global osmflat_icudt
    .type osmflat_icudt, %object
    .balign 16
osmflat_icudt:
    .incbin "@OSMFLAT_ICU_DATA_FILE@"
    .size osmflat_icudt, . - osmflat_icudt

    /* No executable stack. */
    .section .note.GNU-stack,"",%progbits
